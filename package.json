{
  "name": "calendar-estrategico",
  "version": "1.0.0",
  "description": "Dashboard calendário estratégico de disparos Salesforce",
  "homepage": "https://growthafinz.github.io/GaaS-Framework-Afinz",
  "type": "module",
  "engines": { "node": "24.11.1" },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:release": "node scripts/check-types-release.mjs",
    "test:report-live": "node --test scripts/test-report-live-correctness.mjs scripts/test-report-live-publication.mjs scripts/test-report-live-immutable-file.mjs scripts/test-report-live-recovery.mjs scripts/test-report-live-generation.mjs scripts/test-report-live-chart-policy.mjs scripts/test-report-live-editorial.mjs scripts/test-report-live-profiles-outcomes.mjs",
    "test:report-live-office": "python scripts/test_report_live_office_renderer.py",
    "test:growth-feed-sql": "node --test scripts/test-growth-feed-release-2.mjs",
    "test:growth-bets-sql": "node --test scripts/test-growth-bets-release-3b.mjs",
    "validate:report-live-office": "python scripts/validate_report_live_office_output.py --plan tmp/report-live-pptx-poc/render-plan.json --pptx output/pptx/report-live-office-poc-aug-2026.pptx --pdf output/pdf/report-live-office-poc-aug-2026.pdf",
    "check:edge": "npx --yes deno@2.9.6 check --config supabase/functions/deno.json supabase/functions/report-sync/index.ts supabase/functions/report-sync-v4-setup/index.ts supabase/functions/report-sync-build-candidate/index.ts supabase/functions/report-live-meta-preview/index.ts",
    "supabase:cli": "npx --yes supabase@2.117.0",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "build:ontology": "python ../scripts/bundle_vault.py",
    "test": "vitest run"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@supabase/supabase-js": "^2.93.1",
    "clsx": "^2.1.1",
    "date-fns": "^2.30.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.29.2",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.563.0",
    "papaparse": "^5.4.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.5.0",
    "tailwind-merge": "^3.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.1.13",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.2.43",
    "@types/react-beautiful-dnd": "^13.1.5",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "gh-pages": "^6.3.0",
    "playwright": "^1.59.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vitest": "^2.1.9"
  }
}
