                    "governed",
                    "inferred",
                    "missing",
                    "ia"
                  ]
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "justification": {
                  "type": "string"
                }
              },
              "required": [
                "value",
                "origin",
