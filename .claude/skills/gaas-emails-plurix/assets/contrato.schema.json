                            "type": "string",
                            "maxLength": 4000
                          },
                          "text": {
                            "type": "string",
                            "maxLength": 4000
                          }
                        },
                        "required": [
                          "title",
                          "text"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "type",
                    "items"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "check_list"
                    },
                    "items": {
                      "minItems": 1,
                      "type": "array",
