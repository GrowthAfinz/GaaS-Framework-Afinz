  "derived_metrics": [
    {
      "code": "delivery_rate",
      "formula": "delivered / sent",
      "constraint": "mesma ocorrência/população; zero e ausente no denominador não são taxa zero"
    },
    {
      "code": "cost_per_contract",
      "formula": "SUM(cost) / SUM(confirmed_contracts)",
      "constraint": "mesmo período, produto, universo e autoridade; não calcular média de CACs"
    },
    {
      "code": "digital_share",
      "formula": "digital_new_contracts / company_new_sales",
      "constraint": "definições comerciais comparáveis e corte compatível"
    },
    {
      "code": "ipp_insurance",
      "formula": "closing_policies / live_accounts",
      "constraint": "estoques no mesmo corte; não representa necessariamente pessoas únicas"
    },
    {
      "code": "activation_rate_eligible",
      "formula": "activated_accounts / eligible_accounts",
      "constraint": "distinto de ativados/vivos; o material usa denominadores que precisam de contratos separados"
    },
    {
      "code": "activation_rate_live",
      "formula": "activated_accounts / live_accounts",
      "constraint": "não usar como alias de ativados/aptos"
    },
    {
      "code": "voluntary_churn",
      "formula": "voluntary_cancellations / live_accounts_previous_month",
      "constraint": "mesmo ramo e universo; falta do mês anterior bloqueia o cálculo"
    },
    {
      "code": "frequency",
      "formula": "transactions / activated_accounts",
      "constraint": "razão mensal; denominador por definição aprovada"
    },
    {
      "code": "spending",
      "formula": "purchase_amount / activated_accounts",
      "constraint": "razão mensal; YTD ponderado e média das razões mensais são definições distintas"
    },
    {
      "code": "ticket",
      "formula": "purchase_amount / transactions",
      "constraint": "não confundir com spending por ativado"
    },
    {
      "code": "revenue_per_live",
      "formula": "operating_revenue / live_accounts",
      "constraint": "regime contábil, período e tratamento do denominador definidos"
    },
    {
      "code": "engagement_share",
      "formula": "cluster_accounts / eligible_accounts",
      "constraint": "mesma versão do modelo de cluster; percentual arredondado não vira contagem exata"
    },
    {
      "code": "mom_yoy_rxo",
      "formula": "comparable_actual / comparable_baseline - 1",
      "constraint": "baseline, parcialidade, janelas comparáveis e direção do indicador governadas; N/A preservado"
    },
    {
      "code": "media_cpc_registered",
      "formula": "spend / registered_clicks",
      "constraint": "preservar definição de clique; não renomear para CPC de link sem fonte compatível"
    }
  ],
