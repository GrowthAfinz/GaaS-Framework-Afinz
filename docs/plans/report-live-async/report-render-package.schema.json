{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gaas.afinz.com.br/schemas/report-render-package-1.0.json",
  "title": "ReportRenderPackage",
  "description": "Contrato normalizado entre o engine do Report Live e renderers locais de PPTX/PDF.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_kind",
    "run_id",
    "profile",
    "expected_slide_count",
    "coverage_baseline",
    "coverage_accounting",
    "period",
    "publication",
    "source_cutoffs",
    "quality_status",
    "slides"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "package_kind": { "enum": ["production", "archetype_fixture"] },
    "run_id": { "type": "string", "minLength": 1 },
    "profile": { "type": "string", "minLength": 1 },
    "expected_slide_count": { "type": "integer", "minimum": 1 },
    "coverage_baseline": { "$ref": "#/$defs/coverageBaseline" },
    "coverage_accounting": {
      "type": "array",
      "items": { "$ref": "#/$defs/coverageAccountingEntry" }
    },
    "period": { "$ref": "#/$defs/period" },
    "publication": { "$ref": "#/$defs/publication" },
    "source_cutoffs": { "$ref": "#/$defs/sourceCutoffs" },
    "quality_status": { "$ref": "#/$defs/qualityStatus" },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/renderSlide" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "package_kind": { "const": "production" } } },
      "then": {
        "properties": {
          "coverage_accounting": { "type": "array", "minItems": 57, "maxItems": 57 }
        }
      }
    }
  ],
  "$defs": {
    "qualityStatus": {
      "enum": ["confirmed", "directional", "suspect", "blocked"]
    },
    "dataState": {
      "enum": ["valor_observado", "zero_observado", "missing", "nao_aplicavel"]
    },
    "sourceCutoffs": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "string", "format": "date" },
          { "type": "null" }
        ]
      }
    },
    "coverageBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "publication_id", "slide_count", "coverage_map_path"],
      "properties": {
        "run_id": { "const": "9bb55892-4b17-4f76-825a-0ac97c92b525" },
        "publication_id": { "const": "54649269-7cce-460a-a87d-b4cc5f310a62" },
        "slide_count": { "const": 57 },
        "coverage_map_path": { "const": "docs/plans/report-live-async/SLIDE_COVERAGE_MAP.csv" }
      }
    },
    "coverageAccountingEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_page", "baseline_slide_code", "disposition", "target_slide_instance_ids", "rationale"],
      "properties": {
        "baseline_page": { "type": "integer", "minimum": 1, "maximum": 57 },
        "baseline_slide_code": { "type": "string", "minLength": 1 },
        "disposition": {
          "enum": ["preserve", "merge", "omit_no_data", "retire_closed_scope", "retain_as_quality_status"]
        },
        "target_slide_instance_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "data_through"],
      "properties": {
        "start": { "type": "string", "format": "date" },
        "end": { "type": "string", "format": "date" },
        "data_through": {
          "oneOf": [
            { "type": "string", "format": "date" },
            { "type": "null" }
          ]
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_at", "spec_version", "semantic_version", "renderer_version"],
      "properties": {
        "generated_at": { "type": "string", "format": "date-time" },
        "spec_version": { "type": "string", "minLength": 1 },
        "semantic_version": { "type": "string", "minLength": 1 },
        "renderer_version": { "type": "string", "minLength": 1 }
      }
    },
    "renderCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "state"],
      "properties": {
        "value": {
          "oneOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" },
            { "type": "null" }
          ]
        },
        "state": { "$ref": "#/$defs/dataState" }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "rows", "row_count"],
      "properties": {
        "columns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "$ref": "#/$defs/renderCell" }
          }
        },
        "row_count": { "type": "integer", "minimum": 0 }
      }
    },
    "metadataRow": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          { "type": "number" },
          { "type": "boolean" },
          { "type": "null" }
        ]
      }
    },
    "chartContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chart_key",
        "family_view",
        "chart_type",
        "title",
        "domain_column_index",
        "domain_title",
        "left_axis_title",
        "right_axis_title",
        "series",
        "dataset"
      ],
      "properties": {
        "chart_key": { "type": "string", "minLength": 1 },
        "family_view": { "type": "string", "minLength": 1 },
        "chart_type": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "domain_column_index": { "type": "integer", "minimum": 0 },
        "domain_title": { "type": "string", "minLength": 1 },
        "left_axis_title": { "type": "string", "minLength": 1 },
        "right_axis_title": { "type": "string" },
        "series": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/metadataRow" }
        },
        "dataset": { "$ref": "#/$defs/dataset" }
      }
    },
    "geometryBox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archetype", "geometry", "minimum_body_pt", "dataset", "editorial_layout", "editorial_rulers", "chart_contract"],
      "properties": {
        "archetype": {
          "enum": [
            "cover_contract",
            "executive_takeaway",
            "quality_gate",
            "scorecard",
            "time_series_pacing",
            "router_ranking",
            "driver_scatter",
            "funnel",
            "heatmap",
            "analytical_table",
            "action_queue",
            "technical_annex"
          ]
        },
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["visual", "narrative"],
          "properties": {
            "visual": { "$ref": "#/$defs/geometryBox" },
            "narrative": { "$ref": "#/$defs/geometryBox" }
          }
        },
        "minimum_body_pt": { "type": "number", "minimum": 9 },
        "dataset": { "$ref": "#/$defs/dataset" },
        "editorial_layout": {
          "oneOf": [
            { "$ref": "#/$defs/metadataRow" },
            { "type": "null" }
          ]
        },
        "editorial_rulers": {
          "type": "array",
          "items": { "$ref": "#/$defs/metadataRow" }
        },
        "chart_contract": {
          "oneOf": [
            { "$ref": "#/$defs/chartContract" },
            { "type": "null" }
          ]
        }
      }
    },
    "narrative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["takeaway", "evidence", "action", "limitation"],
      "properties": {
        "takeaway": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "items": { "type": "string" }
        },
        "action": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        },
        "limitation": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_view", "evidence_refs", "window_label", "source_cutoffs", "data_hash"],
      "properties": {
        "source_view": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "window_label": { "type": "string", "minLength": 1 },
        "source_cutoffs": { "$ref": "#/$defs/sourceCutoffs" },
        "data_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "renderSlide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slide_instance_id",
        "slide_code",
        "display_order",
        "section",
        "archetype",
        "title",
        "subtitle",
        "partner",
        "audience",
        "eligibility",
        "confidence",
        "narrative",
        "visual",
        "provenance"
      ],
      "properties": {
        "slide_instance_id": { "type": "string", "minLength": 1 },
        "slide_code": { "type": "string", "minLength": 1, "not": { "const": "K-VISA" } },
        "display_order": { "type": "integer", "minimum": 1 },
        "section": { "enum": ["core", "partner", "media", "b2c", "conditional", "annex"] },
        "archetype": { "$ref": "#/$defs/visual/properties/archetype" },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        },
        "partner": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        },
        "audience": { "type": "string", "minLength": 1 },
        "eligibility": { "enum": ["render", "render_com_limites"] },
        "confidence": { "$ref": "#/$defs/qualityStatus" },
        "narrative": { "$ref": "#/$defs/narrative" },
        "visual": { "$ref": "#/$defs/visual" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    }
  }
}
